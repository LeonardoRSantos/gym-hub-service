{
  "info": {
    "name": "Gym Hub Service",
    "description": "API local pela IDE; somente PostgreSQL no Docker. Inicie docker compose up -d e GymHubApplication. Consultas aceitam pagina vazia. A pasta Ciclo de aluno cria um registro novo, guarda seu UUID e o exclui ao final. Execute essa pasta em ordem. Validacoes usam entradas invalidas ou UUID inexistente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "page",
      "value": "0",
      "type": "string"
    },
    {
      "key": "size",
      "value": "10",
      "type": "string"
    },
    {
      "key": "alunoUuid",
      "value": "",
      "type": "string"
    },
    {
      "key": "cpfCadastro",
      "value": "",
      "type": "string"
    },
    {
      "key": "emailCadastro",
      "value": "",
      "type": "string"
    }
  ],

                },
                {
                  "key": "sort",
                  "value": "nome,asc"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Buscar nome inexistente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "description": "Exemplo de busca que pode retornar página vazia.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/aluno?nome=nome-inexistente-colecao&page={{page}}&size={{size}}&sort=nome,asc",
              "host": [

          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Validacao do DTO; o formato do corpo de erro ainda nao e padronizado para Bean Validation.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/aluno",
              "host": [
                "{{baseUrl}}"

    {
      "name": "Ciclo de aluno - executar em ordem",
      "description": "Cria dados novos, consulta, verifica duplicidade, edita e exclui somente o aluno criado. A exclusao e permanente. Usa UUID retornado pelo cadastro, nunca um UUID fixo de outro aluno.",
      "item": [
        {
          "name": "01 - Cadastrar aluno",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const digitos = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10));",
                  "function verificador(d) { const soma = d.reduce((t, n, i) => t + n * (d.length + 1 - i), 0); const resto = (soma * 10) % 11; return resto === 10 ? 0 : resto; }",
                  "digitos.push(verificador(digitos));",
                  "digitos.push(verificador(digitos));",
                  "pm.collectionVariables.set(\"cpfCadastro\", digitos.join(\"\"));",
                  "pm.collectionVariables.set(\"emailCadastro\", \"aluno.collection.\" + Date.now() + \".\" + digitos.join(\"\") + \"@example.com\");",
                  "pm.collectionVariables.unset(\"alunoUuid\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Resposta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/^application\\/json\\b/i); });",
                  "pm.test(\"Dados do aluno\", function () { const aluno = pm.response.json(); pm.expect(aluno.uuid).to.be.a(\"string\"); pm.expect(aluno.nome).to.be.a(\"string\"); });",
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"alunoUuid\", pm.response.json().uuid); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Gera CPF valido sem pontuacao e email novo antes de enviar. Guarda alunoUuid em caso de sucesso.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/aluno",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "aluno"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Aluno Collection\",\n  \"cpf\": \"{{cpfCadastro}}\",\n  \"email\": \"{{emailCadastro}}\",\n  \"dataNascimento\": \"1990-07-08\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },

              "pm.test(\"Resposta JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/^application\\/json\\b/i); });",
              "pm.test(\"Resposta paginada\", function () { const p = pm.response.json(); pm.expect(p.content).to.be.an(\"array\"); pm.expect(p.totalElements).to.be.a(\"number\"); pm.expect(p.number).to.be.a(\"number\"); });"
            ]
